# Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Meta / Instagram — App ID público, usado para montar a URL de Business Login.
# Sem ele o botão "Conectar Instagram" não funciona.
VITE_META_APP_ID=seu-meta-app-id

# Nunca coloque chaves privadas aqui: tudo com prefixo VITE_ vai para o bundle
# público. OpenAI, Stripe, Meta App Secret e a service role do Supabase vivem
# nos secrets das Edge Functions.
