# Copie para .env e ajuste. NÃO comite o .env real.

# Chave de API da Evolution — será também o secret EVOLUTION_API_KEY no Supabase.
# Gere uma forte, ex.: openssl rand -hex 24
AUTHENTICATION_API_KEY=troque-por-uma-chave-bem-grande

# URL pública onde a Evolution responde (com http/https e porta, se for o caso).
# Ex.: https://evo.seudominio.com.br  ou  http://SEU_IP:8080
SERVER_URL=http://localhost:8080

# Senha do Postgres interno da Evolution.
POSTGRES_PASSWORD=troque-esta-senha
